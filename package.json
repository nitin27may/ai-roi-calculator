{
  "name": "ai-cost-roi-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Local, offline AI token, cost and ROI calculator for Azure and Snowflake workloads (CAD).",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @studio/web dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "prices": "pnpm prices:azure && pnpm prices:snowflake",
    "prices:azure": "tsx scripts/prices/azure.ts",
    "prices:snowflake": "tsx scripts/prices/snowflake.ts",
    "validate": "tsx scripts/validate-catalog.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
