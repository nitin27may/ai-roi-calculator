   {
    "id": "vm",
    "label": "Virtual machine",
    "category": "compute",
    "docsUrl": "https://azure.microsoft.com/pricing/details/virtual-machines/windows/",
    "note": "Compute only: add managed disks, backup, public IPs and bandwidth as their own resources. AKS and Windows node pools are priced as these VMs. Spot and low-priority rates are not offered.",
    "inputs": [
     {
      "id": "count",
      "label": "Machines",
      "unit": "machines",
      "help": "How many identical machines run in production."
     }
    ],
    "meters": [
     {
      "id": "compute",
      "label": "Compute",
      "quantity": {
       "input": "count"
      },
      "hourly": true,
      "scalesWithSize": true
     }
    ],
    "options": [
     "payg",
     "ri1",
     "ri3",
     "ahb",
     "devtest"
    ],
    "retail": {
     "filter": "serviceName eq 'Virtual Machines' and armRegionName eq '{region}' and armSkuName eq '{armSku}'",
     "productName": {
      "linux": "^Virtual Machines [A-Za-z0-9 ]+ Series$",
      "windows": "^Virtual Machines [A-Za-z0-9 ]+ Series Windows$"
     },
     "meters": {
      "compute": {
       "meterName": "^(?!.*(Spot|Low Priority))",
       "unit": "VM-month (730 h)"
      }
     },
     "windowsLicence": true
    },
    "ahb": {
     "kind": "linux-twin",
     "note": "A Windows size takes the Linux price of the same size (the Windows Server licence is removed). Linux sizes have no licence component, so Hybrid Benefit does not apply to them."
    },
